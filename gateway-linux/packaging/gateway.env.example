# OmniBazaar Gateway Validator — operator configuration.
# Copy to /etc/omnibazaar/gateway.env before installing the package.
# The postinst sources this file and runs the installer non-interactively.

# Wallet (choose ONE):
#   a) staking account — key derived locally on first start (never sent anywhere)
VALIDATOR_USERNAME=
VALIDATOR_PASSWORD=
#   b) raw private key (0x...)
# VALIDATOR_WALLET_PRIVATE_KEY=

# Network (mainnet for production)
OBZ_NETWORK=mainnet

# This node's public bind host and identity
OBZ_HTTP_HOST=0.0.0.0
OBZ_NODE_ID=gateway-validator-1

# Database (shared YugabyteDB on this host)
OBZ_DB_HOST=127.0.0.1
OBZ_DB_PORT=5433
OBZ_DB_USER=omnibazaar_app
OBZ_DB_PASSWORD=

# Minimum AVAX required for P-Chain validator fees (verified at install)
OBZ_MIN_AVAX=2

# Auto-update (opt-in, OFF by default). The node verifies each release against
# the on-chain UpdateRegistry SHA-256 before applying. Requires a symlink-based
# release layout (releases/<version>/ + a `current` symlink). Leave unset to
# keep update detection report-only.
# OBZ_RELEASES_DIR=/opt/omnicoin-validator/releases
# OBZ_CURRENT_LINK=/opt/omnicoin-validator/current
# OBZ_UPDATER_SYSTEMD_UNIT=omnicoin-validator.service
# OBZ_AUTO_UPDATE_MANDATORY=true   # auto-apply below-minimum (security) updates
# OBZ_AUTO_UPDATE_OPTIONAL=false   # auto-apply ordinary updates
# Set a token to also expose POST /api/v1/updates/apply (requires the token in
# the x-updater-token header); leave unset to keep manual apply disabled.
# OBZ_UPDATER_ADMIN_TOKEN=
