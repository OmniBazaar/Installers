# OmniBazaar Gateway Validator — operator configuration.
# Copy to /etc/omnibazaar/gateway.env before installing the package.
# The postinst sources this file and runs the installer non-interactively.

# Wallet (choose ONE):
#   a) staking account — key derived locally on first start (never sent anywhere).
#      These are the exact env vars the gateway reads to derive its wallet.
STAKING_USERNAME=
STAKING_PASSWORD=
#   b) raw private key (0x...)
# VALIDATOR_WALLET_PRIVATE_KEY=

# Network (mainnet for production)
OBZ_NETWORK=mainnet

# This node's public bind host and identity
OBZ_HTTP_HOST=0.0.0.0
OBZ_NODE_ID=gateway-validator-1

# Database (shared YugabyteDB on this host)
OBZ_DB_HOST=127.0.0.1
OBZ_DB_PORT=5433
OBZ_DB_USER=omnibazaar_app
OBZ_DB_PASSWORD=

# Minimum AVAX required for P-Chain validator fees (verified at install)
OBZ_MIN_AVAX=2

# Auto-update (opt-in, OFF by default). The installer configures the symlink
# release layout automatically; the node verifies each release against the
# on-chain UpdateRegistry SHA-256 before applying. To enable unattended
# application set a flag here — the installer bakes it into the unit:
# OBZ_AUTO_UPDATE_MANDATORY=true   # auto-apply below-minimum (security) updates
# OBZ_AUTO_UPDATE_OPTIONAL=true    # auto-apply ordinary updates
#
# Manual apply endpoint (POST /api/v1/updates/apply, x-updater-token header) is
# disabled unless a token is set. Put it in the node's runtime env file (600),
# NOT here — gateway.env is only read at install time:
#   echo 'OBZ_UPDATER_ADMIN_TOKEN=<random>' | sudo tee -a /etc/omnicoin-validator/environment
#
# ── Node gas faucet (optional, and a role decision) ────────────────────────
# A listing node installs with no XOM and there is no screen in the product for
# sending native gas, so a gateway can pay the registration fee on its behalf:
# 0.5 XOM once per address, on proof of key control (POST /api/v1/node/gas).
#
# These are RUNTIME secrets, like the updater token: put them in
# /etc/omnicoin-validator/environment (mode 600), never in this file and never in
# source control. Use a DEDICATED funded wallet, not the deployer key — the
# deployer is admin of every contract.
#   NODE_GAS_FAUCET_KEY=<private key of the faucet wallet>
#   NODE_GAS_FAUCET_RPC=https://rpc.omnicoin.net
#
# Without them the endpoint answers `gas_faucet_not_configured` rather than
# pretending, and operators must fund their own node.
#
# Requires the `node_gas_drips` table (migrations/20261103_node_gas_drips.sql).
# It is applied on the shared cluster; a fresh deployment must apply it before any
# gateway turns the faucet on, or every drip fails at the ledger write.
