# OmniBazaar Service Node — operator configuration.
# Copy to /etc/omnibazaar/service.env before installing the package.
# The postinst sources this file and runs the installer non-interactively.

# Wallet (choose ONE):
#   a) staking account — key derived locally on first start (never sent anywhere).
#      These are the exact env vars the service node reads to derive its wallet.
STAKING_USERNAME=
STAKING_PASSWORD=
#   b) raw private key (0x...)
# VALIDATOR_WALLET_PRIVATE_KEY=

# Network (mainnet for production)
OBZ_NETWORK=mainnet

# This node's public bind host and identity
OBZ_HTTP_HOST=0.0.0.0
OBZ_NODE_ID=service-node-1

# Database — the node's OWN local-DB replica (single-node YugabyteDB provisioned
# on this host). A service node holds NO shared-database credentials: it relays
# seller-signed listings UP via the gateway REST API (gateway re-verifies the
# EIP-712 signature and is the sole DB writer) and pulls its home listings DOWN
# via GET /api/v1/node/listings/delta into this local replica.
OBZ_DB_HOST=127.0.0.1
OBZ_DB_PORT=5433
OBZ_DB_USER=omnibazaar_app
OBZ_DB_PASSWORD=

# Service-node qualification (enforced by the node at runtime). Service nodes
# need participation >= 25; no stake, KYC, or AVAX required.
OBZ_SERVICE_MIN_PARTICIPATION=25

# Pioneer exemption (optional): add the node's own derived address to
# PIONEER_FOUNDER_ALLOWLIST in the RUNTIME env file — NOT here (service.env is
# read only at install time):
#   echo 'PIONEER_FOUNDER_ALLOWLIST=0x...' | sudo tee -a /etc/omnicoin-service-node/environment
# Comma-separated, lowercased. Skips participation/stake/KYC/AVAX for node
# qualification. Pioneer-only — removed at the post-Pioneer migration.

# Auto-update (opt-in, OFF by default). The installer configures the symlink
# release layout automatically; the node verifies each release against the
# on-chain UpdateRegistry SHA-256 before applying. To enable unattended
# application set a flag here — the installer bakes it into the unit:
# OBZ_AUTO_UPDATE_MANDATORY=true   # auto-apply below-minimum (security) updates
# OBZ_AUTO_UPDATE_OPTIONAL=true    # auto-apply ordinary updates
#
# Manual apply endpoint (POST /api/v1/updates/apply, x-updater-token header) is
# disabled unless a token is set. Put it in the node's runtime env file (600),
# NOT here — service.env is only read at install time:
#   echo 'OBZ_UPDATER_ADMIN_TOKEN=<random>' | sudo tee -a /etc/omnicoin-service-node/environment
