#!/usr/bin/env bash
# Debian/RPM post-install: run the bundled service-node installer non-interactively.
# Operator config is read from /etc/omnibazaar/service.env (see service.env.example).
set -e

INSTALL_ROOT="/opt/omnicoin-service-node"
CFG="/etc/omnibazaar/service.env"
INSTALLER="$INSTALL_ROOT/Validator/scripts/install-service-node.sh"

if [ ! -f "$CFG" ]; then
  echo "OmniBazaar: no $CFG found."
  echo "Create it from $INSTALL_ROOT/service.env.example, then run:"
  echo "  sudo OBZ_NONINTERACTIVE=1 OBZ_SKIP_BUILD=1 bash $INSTALLER"
  exit 0
fi

# shellcheck disable=SC1090
set -a; . "$CFG"; set +a

# Files are already placed by the package manager; ship pre-built dist/, so skip
# the code-copy (dir already exists) and the npm build.
export OBZ_NONINTERACTIVE=1
export OBZ_SKIP_BUILD=1
export OBZ_INSTALL_DIR="$INSTALL_ROOT"
export OBZ_NETWORK="${OBZ_NETWORK:-mainnet}"

bash "$INSTALLER"
